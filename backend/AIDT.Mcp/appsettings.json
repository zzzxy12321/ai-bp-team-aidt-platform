{
  "AIDT": {
    "ProjectState": "MCP_READY",
    "Database": {
      "Provider": "Microsoft.EntityFrameworkCore.SqlServer",
      "IsReady": true,
      "MigrationState": "applied_verified"
    },
    "ExternalSystems": {
      "Mode": "Mock",
      "AllowWrites": false
    },
    "Workflow": {
      "Provider": "ElsaWorkflows",
      "IsConfigured": true,
      "RunMigrationsOnStartup": false
    },
    "Data": {
      "CurrentEnvironmentCode": "demo",
      "IncludeTestDataByDefault": false
    },
    "BusinessTime": {
      "TimeZoneId": "Asia/Shanghai",
      "DeadlineHour": 18
    },
    "FileStorage": {
      "RootPath": "C:\\ProgramData\\AIDT\\uploads",
      "MaxSizeBytes": 52428800
    },
    "Authentication": {
      "DataProtectionKeysPath": "C:\\ProgramData\\AIDT\\keys"
    },
    "Mcp": {
      "PublicBaseUrl": "http://127.0.0.1:8088",
      "SystemAuditUserId": "10000000-0000-0000-0000-000000000024",
      "MaxRequestsPerMinute": 120,
      "MaxResponseBytes": 1048576,
      "MaxRequestBytes": 10485760
    }
  },
  "ConnectionStrings": {
    "Aidt": "Server=np:\\\\.\\pipe\\sql\\query;Database=AIDT;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol": "Warning"
    }
  },
  "AllowedHosts": "*"
}
